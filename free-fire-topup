    <!-- RECEIPT MODAL -->
    <div id="receiptModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-gray-900 border border-emerald-500/40 rounded-3xl w-full max-w-md p-6 space-y-6 text-center">
            <h3 class="text-2xl font-black text-white">অর্ডার সফলভাবে জমা হয়েছে!</h3>
            <div class="bg-gray-950 p-4 rounded-2xl border border-gray-800 text-left text-xs space-y-2 font-mono">
                <div class="flex justify-between"><span class="text-gray-400">অর্ডার আইডি:</span><span id="recOrderId" class="text-yellow-400 font-bold">#FF0000</span></div>
                <div class="flex justify-between"><span class="text-gray-400">প্যাকেজ:</span><span id="recPkgName" class="text-white">Diamond Pack</span></div>
                <div class="flex justify-between"><span class="text-gray-400">প্লেয়ার UID:</span><span id="recPlayerUid" class="text-orange-400">000000</span></div>
                <div class="flex justify-between"><span class="text-gray-400">মোট টাকা:</span><span id="recTotal" class="text-emerald-400 font-bold">৳0</span></div>
            </div>
            <button onclick="closeReceiptModal()" class="w-full py-3.5 bg-orange-600 text-white font-bold rounded-xl text-xs">ঠিক আছে</button>
        </div>
    </div>

    <script>
        let defaultPackages = [
            { id: 1, title: '25 Diamonds', price: 25, cat: 'Standard', badge: 'Starter' },
            { id: 2, title: '50 Diamonds', price: 45, cat: 'Standard', badge: 'Popular' },
            { id: 3, title: '115 Diamonds', price: 80, cat: 'Standard', badge: 'Best Seller' },
            { id: 4, title: '240 Diamonds', price: 165, cat: 'Standard', badge: 'Hot Pack' },
            { id: 5, title: '610 Diamonds', price: 420, cat: 'Standard', badge: 'Super Offer' },
            { id: 6, title: '520 Diamonds [Carding Special]', price: 290, cat: 'Carding', badge: 'Carding 🔥' },
            { id: 7, title: '1060 Diamonds [Carding Special]', price: 550, cat: 'Carding', badge: 'Carding 🔥' },
            { id: 8, title: 'Weekly Membership', price: 160, cat: 'Membership', badge: 'Weekly' },
            { id: 9, title: 'Monthly Membership', price: 750, cat: 'Membership', badge: 'VIP' }
        ];

        let defaultSettings = { paymentNumber: '01991545695', adminEmail: 'ibrahinhossen62850@gmail.com', siteTitle: 'ফ্রি ফায়ার কার্ডিং ডায়মন্ড' };
        let defaultOrders = { "#FF8392": { id: "#FF8392", pkg: "520 Diamonds [Carding Special]", price: 290, uid: "192837465", ign: "SR_GAMER", payment: "bKash", senderPhone: "01991545695", trx: "8N9A32K", status: "Completed", date: "2026-10-26" } };

        if (!localStorage.getItem('ff_pkgs_v2')) localStorage.setItem('ff_pkgs_v2', JSON.stringify(defaultPackages));
        if (!localStorage.getItem('ff_settings_v2')) localStorage.setItem('ff_settings_v2', JSON.stringify(defaultSettings));
        if (!localStorage.getItem('ff_orders_v2')) localStorage.setItem('ff_orders_v2', JSON.stringify(defaultOrders));

        let currentActivePkg = null;
        let selectedCategory = 'All';

        window.onload = function() { renderPackages(); updateGlobalSettingsDisplay(); };

        function getPackages() { return JSON.parse(localStorage.getItem('ff_pkgs_v2')); }
        function getSettings() { return JSON.parse(localStorage.getItem('ff_settings_v2')); }
        function getOrders() { return JSON.parse(localStorage.getItem('ff_orders_v2')); }

        function updateGlobalSettingsDisplay() {
            const st = getSettings();
            document.getElementById('topBarNumber').innerText = st.paymentNumber;
            document.getElementById('bkashNumberDisplay').innerText = st.paymentNumber;
            document.getElementById('nagadNumberDisplay').innerText = st.paymentNumber;
            document.getElementById('activeSendNumber').innerText = st.paymentNumber;
            document.getElementById('siteTitleNav').innerText = st.siteTitle;
        }

        function renderPackages() {
            const pkgs = getPackages();
            const grid = document.getElementById('productGrid');
            grid.innerHTML = '';
            const filtered = selectedCategory === 'All' ? pkgs : pkgs.filter(p => p.cat === selectedCategory);

            filtered.forEach(pkg => {
                grid.innerHTML += `
                    <div class="bg-gray-900 border border-gray-800 rounded-3xl p-4 sm:p-5 flex flex-col justify-between hover:border-orange-500/50 transition">
                        <span class="absolute top-2.5 right-2.5 bg-orange-500/10 text-orange-400 border border-orange-500/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full">${pkg.badge}</span>
                        <div>
                            <div class="w-12 h-12 rounded-2xl bg-orange-600/20 text-amber-400 flex items-center justify-center text-2xl mb-3">💎</div>
                            <h3 class="text-sm sm:text-base font-bold text-white">${pkg.title}</h3>
                        </div>
                        <div class="mt-4 pt-3 border-t border-gray-800 flex items-center justify-between">
                            <span class="text-base font-black text-emerald-400">৳${pkg.price}</span>
                            <button onclick="openCheckoutModal(${pkg.id})" class="px-4 py-2 bg-orange-600 text-white font-extrabold text-xs rounded-xl">কিনুন</button>
                        </div>
                    </div>
                `;
            });
        }

        function filterCategory(cat) { selectedCategory = cat; renderPackages(); }

        function openCheckoutModal(pkgId) {
            currentActivePkg = getPackages().find(p => p.id === pkgId);
            if (!currentActivePkg) return;
            document.getElementById('modalPkgTitle').innerText = currentActivePkg.title;
            document.getElementById('modalPkgPrice').innerText = `৳${currentActivePkg.price} BDT`;
            document.getElementById('modalTotalPayable').innerText = `৳${currentActivePkg.price} BDT`;
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() { document.getElementById('checkoutModal').classList.add('hidden'); }
        function updatePaymentNumberDisplay() { document.getElementById('activeSendNumber').innerText = getSettings().paymentNumber; }

        function submitOrder() {
            const uid = document.getElementById('playerUidInput').value.trim();
            const ign = document.getElementById('playerIgnInput').value.trim();
            const senderPhone = document.getElementById('senderPhoneInput').value.trim();
            const trxId = document.getElementById('trxIdInput').value.trim();
            const method = document.querySelector('input[name="payMethod"]:checked').value;

            if (!uid || !ign || !senderPhone || !trxId) { alert("সব তথ্য সঠিকভাবে পূরণ করুন!"); return; }

            const orderId = '#FF' + Math.floor(1000 + Math.random() * 9000);
            const orders = getOrders();
            orders[orderId] = { id: orderId, pkg: currentActivePkg.title, price: currentActivePkg.price, uid, ign, payment: method, senderPhone, trx: trxId.toUpperCase(), status: "Pending", date: new Date().toLocaleString() };
            localStorage.setItem('ff_orders_v2', JSON.stringify(orders));

            document.getElementById('recOrderId').innerText = orderId;
            document.getElementById('recPkgName').innerText = currentActivePkg.title;
            document.getElementById('recPlayerUid').innerText = uid;
            document.getElementById('recTotal').innerText = `৳${currentActivePkg.price}`;

            closeCheckoutModal();
            document.getElementById('receiptModal').classList.remove('hidden');
        }

        function closeReceiptModal() { document.getElementById('receiptModal').classList.add('hidden'); }

        function trackOrder() {
            const query = document.getElementById('trackerInput').value.trim().toUpperCase();
            const resultBox = document.getElementById('trackerResult');
            const orders = getOrders();
            const order = orders[query];
            if (!order) { resultBox.innerHTML = `<div class="text-center text-rose-400 font-bold">অর্ডার পাওয়া যায়নি!</div>`; resultBox.classList.remove('hidden'); return; }
            resultBox.innerHTML = `<div class="space-y-2 text-xs font-mono"><p class="text-white">স্ট্যাটাস: <span class="text-emerald-400">${order.status}</span></p><p class="text-white">প্যাকেজ: ${order.pkg}</p></div>`;
            resultBox.classList.remove('hidden');
        }

        function openAdminLoginModal() { document.getElementById('adminLoginModal').classList.remove('hidden'); }
        function closeAdminLoginModal() { document.getElementById('adminLoginModal').classList.add('hidden'); }

        function authenticateAdmin() {
            const email = document.getElementById('adminEmailInput').value.trim();
            const pass = document.getElementById('adminPassInput').value.trim();
            if (email === 'ibrahinhossen62850@gmail.com' && (pass === 'admin123' || pass === '')) {
                closeAdminLoginModal();
                showSection('admin');
                loadAdminDashboard();
            } else { alert("ভুল পাসওয়ার্ড! (Default: admin123)"); }
        }

        function logoutAdmin() { showSection('home'); }

        function loadAdminDashboard() {
            const orders = getOrders();
            const pkgs = getPackages();
            const st = getSettings();
            const orderKeys = Object.keys(orders);
            let totalRev = 0, pendingCount = 0;
            orderKeys.forEach(k => { totalRev += orders[k].price; if (orders[k].status === 'Pending') pendingCount++; });

            document.getElementById('statTotalOrders').innerText = orderKeys.length;
            document.getElementById('statTotalRevenue').innerText = `৳${totalRev}`;
            document.getElementById('statPendingOrders').innerText = pendingCount;

            const tbody = document.getElementById('adminOrdersTableBody');
            tbody.innerHTML = '';
            orderKeys.reverse().forEach(key => {
                const ord = orders[key];
                tbody.innerHTML += `
                    <tr class="border-b border-gray-800">
                        <td class="p-3 font-mono text-yellow-400">${ord.id}</td>
                        <td class="p-3 text-orange-400">${ord.uid}<br><span class="text-[10px] text-gray-400">${ord.ign}</span></td>
                        <td class="p-3 text-white">${ord.pkg}</td>
                        <td class="p-3 font-mono">${ord.payment}<br><span class="text-[10px]">Trx: ${ord.trx}</span></td>
                        <td class="p-3 text-emerald-400">৳${ord.price}</td>
                        <td class="p-3 font-bold">${ord.status}</td>
                        <td class="p-3 text-right">
                            <button onclick="changeOrderStatus('${ord.id}', 'Completed')" class="px-2 py-1 bg-emerald-600/30 text-emerald-300 rounded text-[11px]">Complete</button>
                            <button onclick="deleteOrder('${ord.id}')" class="px-2 py-1 bg-gray-800 text-gray-400 rounded text-[11px]">Delete</button>
                        </td>
                    </tr>
                `;
            });

            const adminPkgList = document.getElementById('adminPackagesList');
            adminPkgList.innerHTML = '';
            pkgs.forEach(p => {
                adminPkgList.innerHTML += `<div class="bg-gray-950 p-3 rounded-xl flex justify-between items-center text-xs"><span class="text-white">${p.title} (৳${p.price})</span><button onclick="deletePackage(${p.id})" class="text-rose-400">Delete</button></div>`;
            });
        }

        function changeOrderStatus(id, status) { const o = getOrders(); o[id].status = status; localStorage.setItem('ff_orders_v2', JSON.stringify(o)); loadAdminDashboard(); }
        function deleteOrder(id) { const o = getOrders(); delete o[id]; localStorage.setItem('ff_orders_v2', JSON.stringify(o)); loadAdminDashboard(); }
        function clearAllOrders() { localStorage.setItem('ff_orders_v2', JSON.stringify({})); loadAdminDashboard(); }

        function savePaymentNumbers() {
            const num = document.getElementById('settingPaymentNumberInput').value.trim();
            const title = document.getElementById('settingSiteTitleInput').value.trim();
            const st = getSettings();
            st.paymentNumber = num; st.siteTitle = title || st.siteTitle;
            localStorage.setItem('ff_settings_v2', JSON.stringify(st));
            updateGlobalSettingsDisplay();
            alert("സেটিংস সেভ হয়েছে!");
        }

        function addNewPackage() {
            const title = document.getElementById('newPkgTitle').value.trim();
            const price = parseFloat(document.getElementById('newPkgPrice').value);
            const cat = document.getElementById('newPkgCat').value;
            const badge = document.getElementById('newPkgBadge').value.trim() || 'Hot';
            if (!title || isNaN(price)) { alert("নাম ও মূল্য দিন!"); return; }
            const pkgs = getPackages();
            pkgs.push({ id: pkgs.length + 1, title, price, cat, badge });
            localStorage.setItem('ff_pkgs_v2', JSON.stringify(pkgs));
            renderPackages(); loadAdminDashboard(); alert("প্যাকেজ যোগ হয়েছে!");
        }

        function deletePackage(id) {
            let pkgs = getPackages().filter(p => p.id !== id);
            localStorage.setItem('ff_pkgs_v2', JSON.stringify(pkgs));
            renderPackages(); loadAdminDashboard();
        }

        function copyToClipboard(text, msg) {
            navigator.clipboard.writeText(text);
            alert(msg || "কপি করা হয়েছে!");
        }

        function showSection(id) {
            ['home', 'tracker', 'admin'].forEach(s => document.getElementById(`section-${s}`).classList.add('hidden'));
            document.getElementById(`section-${id}`).classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() { document.getElementById('mobileMenu').classList.toggle('hidden'); }
    </script>
